# Copy to .env on the server (next to compose.yaml)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MATCH_SECONDS=300
PODIUM_SECONDS=15
MAX_PLAYERS=24
WARMUP_MIN_PLAYERS=2
# Modes in the rotation and the end-of-match vote (default: tdm, ffa, ctf, defuse)
GAME_MODES=tdm,ffa,ctf,defuse
# Maps in the rotation and the vote, any of: forja, escritorio (empty = all)
GAME_MAPS=
# Team kills that end a TDM match early (0 = timer only)
TDM_SCORE_LIMIT=50
# Bots top the match up to this many players while at least one person is online (0 = no bots, the default)
BOT_FILL=0
# Bot skill 0-100
BOT_SKILL=45
# Optional: require an office code to join (leave empty for open lobby)
JOIN_CODE=

# Captures that end a CTF match early (0 = timer only)
CTF_CAPTURE_LIMIT=3
# Rounds that end a debug defusion match early (0 = timer only)
DEFUSE_SCORE_LIMIT=5
# Seconds the attackers have to plant the laptop before the other team gets it with a new variation (0 = no limit)
DEFUSE_PLANT_TIMEOUT_SECONDS=60
# Team modes only: 1 makes bullets hurt teammates (teamkills score nothing), 0 keeps them harmless (default)
FRIENDLY_FIRE=0
# New players wait on the "pronto" screen. 1 sends back to the lobby whoever has not confirmed after READY_KICK_SECONDS (5-600) or when the match ends; 0 never kicks
READY_KICK=1
READY_KICK_SECONDS=20
# 1 sends back to the lobby a player who sends no input (keys, mouse, weapon change; MCP agents: any tool call) for IDLE_KICK_SECONDS (10-3600), the podium does not count; 0 never kicks
IDLE_KICK=1
IDLE_KICK_SECONDS=30
