# Copy to .env on the server (next to compose.yaml)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MATCH_SECONDS=300
PODIUM_SECONDS=15
MAX_PLAYERS=24
WARMUP_MIN_PLAYERS=2
# Modes in the rotation and the end-of-match vote (default: tdm, ffa, ctf, defuse)
GAME_MODES=tdm,ffa,ctf,defuse
# Maps in the rotation and the vote, any of: forja, escritorio (empty = all)
GAME_MAPS=
# Team kills that end a TDM match early (0 = timer only)
TDM_SCORE_LIMIT=50
# Bots top the match up to this many players while at least one person is online (0 = no bots, the default)
BOT_FILL=0
# Bot skill 0-100
BOT_SKILL=45
# Optional: require an office code to join (leave empty for open lobby)
JOIN_CODE=

# Captures that end a CTF match early (0 = timer only)
CTF_CAPTURE_LIMIT=3
# Rounds that end a debug defusion match early (0 = timer only)
DEFUSE_SCORE_LIMIT=5
# 1 gives the laptop to the other team, with a new variation, when the attackers have not planted after DEFUSE_PLANT_TIMEOUT_SECONDS (0-3600, 0 = no limit); 0 never takes it away
DEFUSE_PLANT_TIMEOUT=1
DEFUSE_PLANT_TIMEOUT_SECONDS=30
# Team modes only: 1 makes bullets hurt teammates (teamkills score nothing), 0 keeps them harmless (default)
FRIENDLY_FIRE=0
# Players wait on the "pronto" screen when they join and after every podium. 1 sends back to the lobby whoever has not confirmed after READY_KICK_SECONDS (5-600) or when the match ends; 0 never kicks
READY_KICK=1
READY_KICK_SECONDS=180
# 1 sends back to the lobby a player who sends no input (keys, mouse, weapon change; MCP agents: any tool call) for IDLE_KICK_SECONDS (10-3600), the podium does not count; 0 never kicks
IDLE_KICK=1
IDLE_KICK_SECONDS=60
# The same during the warmup, while players wait for the match to fill up (10-3600)
IDLE_KICK_WARMUP_SECONDS=300
# Radio spam guard per player: minimum gap between lines (CS 1.6 mp_radio_timeout, decimals allowed),
# then at most RADIO_MAX_PER_WINDOW lines in any RADIO_WINDOW_SECONDS (0 = no cap). Extra lines are dropped silently
RADIO_COOLDOWN_SECONDS=1.5
RADIO_MAX_PER_WINDOW=3
RADIO_WINDOW_SECONDS=10
