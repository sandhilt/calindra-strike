{
  "name": "calindra-strike",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "cd server && node --run dev",
    "dev:client": "cd client && node --run dev",
    "build:client": "cd client && node --run build",
    "start:server": "cd server && node --run start",
    "typecheck": "tsc -p shared && tsc -p shared/test && tsc -p server && tsc -p client && tsc -p tools",
    "test": "node --test \"shared/test/*.test.ts\" \"server/test/*.test.ts\" \"tools/test/*.test.ts\"",
    "bots": "node tools/bots.ts",
    "bench": "node tools/bench.ts",
    "mcp": "node tools/mcp/launch.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  }
}
